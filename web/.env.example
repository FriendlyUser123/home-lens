# Model provider: gemini (default) | ollama | mock
MODEL_PROVIDER=gemini
# Gemma 4 through the Gemini API. Get a key at https://aistudio.google.com/apikey . Never commit it.
GEMINI_API_KEY=
GEMINI_MODEL=gemma-4-26b-a4b-it
# Local, open-weight mode (MODEL_PROVIDER=ollama)
OLLAMA_URL=http://localhost:11435
OLLAMA_MODEL=gemma4:e4b
# API port (the Vite dev server proxies /api here)
PORT=8710
